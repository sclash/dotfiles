	"lsp": {
		"texlab": {
			"command": [
				"texlab"
			],
			"extensions": [
				".tex",
				".bib"
			]
		},
		"tailwind": {
			"command": [
				"npx",
				"-p",
				"@tailwindcss/language-server",
				"-y",
				"tailwindcss-language-server",
				"--stdio"
			],
			"extensions": [
				".css",
				".htmx",
				".vue",
				".jsx",
				".tsx"
			]
		},
		"quickshell": {
			"command": [
				"qmlls",
				"-E"
			],
			"extensions": [
				".qml",
				".qmljs"
			]
		}
	},
	"mcp": {
		"servers": {
			"markitdown": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"nixpkgs#markitdown-mcp"
				],
				"disabled": true
			},
			"ripwire": {
				"type": "local",
				"command": [
					"ripwire",
					"--mcp"
				],
				"disabled": true
			},
			"arxiv": {
				"type": "local",
				"command": [
					"uvx",
					"--from",
					"arxiv-mcp-server[pdf]",
					"arxiv-mcp-server"
				],
				"disabled": true
			},
			"graphify": {
				"type": "local",
				"command": [
					"graphify-mcp",
					"./graphify-out/graph.json"
				],
				"disabled": true
			},
			"openrouter": {
				"type": "remote",
				"url": "https://mcp.openrouter.ai/mcp",
				"disabled": true
			},
			"playwright": {
				"type": "local",
				"command": [
					"npx",
					"@playwright/mcp@latest"
				],
				"disabled": true
			},
			// The bunx variant is kept as a comment, as in the V1 file:
			// "shadcn-vue": {
			// 	"type": "local",
			// 	"enabled": false,
			// 	"command": [
			// 		"bunx",
			// 		"--bun",
			// 		"shadcn-vue@latest",
			// 		"mcp",
			// 		"init",
			// 		"--client",
			// 		"opencode"
			// 	]
			// },
			"shadcn-vue": {
				"type": "local",
				"command": [
					"npx",
					"shadcn-vue@latest",
					"mcp"
				],
				"disabled": true
			},
			"nixos": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"github:utensils/mcp-nixos",
					"--"
				],
				"disabled": true
			},
			"chrome-devtools": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"chrome-devtools-mcp@latest"
				],
				"disabled": true
			},
			"github": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"nixpkgs#github-mcp-server",
					"--",
					"stdio"
				],
				"disabled": true
			},
			"filesystem": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"@modelcontextprotocol/server-filesystem",
					"/home/asergi/",
					"/home/asergi/hacking/",
					"/home/asergi/Downloads/"
				],
				"disabled": true
			}
		}
	},
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git"
	],
	"instructions": [
		"AGENTS.md",
		"CLAUDE.md",
		"RIPWIRE.md"
	],
	"agents": {
		"title": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"build": {
			"description": "Primary coding agent for development work",
			"mode": "primary"
		}
	},
	"permissions": [
		{
			"action": "mcp_*",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "external_directory",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "read",
			"resource": "**/.env",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.local",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.production",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.development",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.secrets",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.secrets.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/secrets",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/secrets.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/credentials",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/credentials.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/id_rsa",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/id_rsa.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.pem",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.key",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.p12",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "/run/secrets",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "/run/secrets.d",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "/run/secrets.d/**",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "/run/secrets/**",
			"effect": "deny"
