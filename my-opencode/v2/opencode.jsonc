{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode-go/mimo-v2.6-pro",
	"providers": {
		"llama.cpp": {
			"package": "aisdk:@ai-sdk/openai-compatible",
			"name": "llama-server (vast.ai)",
			"settings": {
				"baseURL": "https://notebooks-jane-themes-pros.trycloudflare.com/"
			},
			"models": {
				"unsloth/Qwen3.6-27B-GGUF": {
					"name": "Qwen3.6-27B"
				}
			}
		},
		"openrouter": {
			"settings": {
				"apiKey": "{file:/run/secrets/openrouter}"
			},
			"models": {
				"xiaomi/mimo-v2.6-pro": {},
				"openai/gtp-6-astra-pro": {
					"settings": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6-astra": {
					"settings": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6.1-sol-pro": {
					"settings": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6.1-sol": {
					"settings": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4.1-flash": {
					"settings": {
						"provider": {
							"order": [
								"deepseek"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4-pro-0813": {
					"settings": {
						"provider": {
							"order": [
								"streamlake"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4-flash-0731": {
					"settings": {
						"provider": {
							"order": [
								"open-inference/fp8",
								"akashml/fp8"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3": {
					"settings": {
						"provider": {
							"order": [
								"friendli",
								"cloudflare",
								"akashml/fp8"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3-flash": {
					"settings": {
						"provider": {
							"order": [
								"z-ai/fp8",
								"novita/fp8",
								"deepinfra/fp8",
								"gmicloud/fp8"
							],
							"allow_fallbacks": false
						}
					}
				}
			}
		},
		"opencode-go": {
			"settings": {
				"apiKey": "{file:/run/secrets/opencode}"
			}
		},
		"opencode": {
			"settings": {
				"apiKey": "{file:/run/secrets/opencode}"
			}
		},
		"cheaper-inference": {
			"package": "aisdk:@ai-sdk/openai-compatible",
			"name": "Cheaper Inference",
			"settings": {
				"baseURL": "https://api.cheaperinference.com/v1",
				"apiKey": "{file:/run/secrets/cheaper_inference}"
			},
			"models": {
				"glm-5.3": {
					"name": "glm-5.3",
					"variants": [
						{
							"id": "low",
							"settings": {
								"reasoningEffort": "low"
							}
						},
						{
							"id": "high",
							"settings": {
								"reasoningEffort": "high"
							}
						},
						{
							"id": "max",
							"settings": {
								"reasoningEffort": "max"
							}
