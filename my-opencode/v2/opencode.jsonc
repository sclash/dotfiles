	// NOTE: OpenCode V2 (through 2.2.1) validates and preserves this block but
	// has no LSP runtime: it never starts a server or surfaces diagnostics.
	// Entries mirror neovimrc/after/plugin/lsp.lua so they work if upstream
	// port lands (anomalyco/opencode#38528). For working diagnostics today, use
	// the diagnostics-fallback skill.
	"lsp": {
		"clangd": {
			"command": [
				"clangd",
				"--background-index",
				"--clang-tidy"
			],
			"extensions": [
				".c",
				".h",
				".cc",
				".cpp",
				".cxx",
				".hpp",
				".hxx",
				".m",
				".mm",
				".cu",
				".cuh"
			]
		},
		"nixd": {
			"command": [
				"nixd"
			],
			"extensions": [
				".nix"
			],
			// Same options as the neovim config. `formatting` is intentionally
			// omitted because nixfmt is not installed on this system.
			"initialization": {
				"nixpkgs": {
					"expr": "import <nixpkgs> { }"
				},
				"options": {
					"nixos": {
						"expr": "(builtins.getFlake (\"git+file://\" + builtins.getEnv \"HOME\" + \"/dotfiles?dir=nixos\")).nixosConfigurations.default.options"
					},
					"home_manager": {
						"expr": "(builtins.getFlake (\"git+file://\" + builtins.getEnv \"HOME\" + \"/dotfiles?dir=nixos\")).homeConfigurations.default.options"
					},
					"flake_parts": {
						"expr": "let flake = builtins.getFlake (\"git+file://\" + builtins.getEnv \"HOME\" + \"/dotfiles?dir=nixos\"); in flake.debug.options // flake.currentSystem.options"
					}
				}
			}
		},
		"qmlls": {
			"command": [
				"qmlls",
				"-E",
				"-I",
				"/etc/profiles/per-user/asergi/lib/qt-6/qml"
			],
			"extensions": [
				".qml",
				".qmljs"
			]
		},
		"rust_analyzer": {
			"command": [
				"rust-analyzer"
			],
			"extensions": [
				".rs"
			]
		},
		"pyright": {
			"command": [
				"pyright-langserver",
				"--stdio"
			],
			"extensions": [
				".py",
				".pyi"
			]
		},
		"lua_ls": {
			"command": [
				"lua-language-server"
			],
			"extensions": [
				".lua"
			]
		},
		"bashls": {
			"command": [
				"bash-language-server",
				"start"
			],
			"extensions": [
				".sh",
				".bash",
				".zsh"
			]
		},
		"gopls": {
			"command": [
				"gopls"
			],
			"extensions": [
				".go",
				".mod",
				".sum",
				".work"
			]
		},
		"zls": {
			"command": [
				"zls"
			],
			"extensions": [
				".zig",
				".zon",
				".zir"
			]
		},
		// vtsls needs the @vue/typescript-plugin initialization used in
		// neovim to understand .vue files; .vue is left to vue_ls here.
		"vtsls": {
			"command": [
				"vtsls",
				"--stdio"
			],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts"
			]
		},
		"vue_ls": {
			"command": [
				"vue-language-server",
				"--stdio"
			],
			"extensions": [
				".vue"
			]
		},
		"html": {
			"command": [
				"vscode-html-language-server",
				"--stdio"
			],
			"extensions": [
				".html",
				".htm"
			]
		},
		"jsonls": {
			"command": [
				"vscode-json-language-server",
				"--stdio"
			],
			"extensions": [
				".json",
				".jsonc"
			]
		},
		"tailwindcss": {
			"command": [
				"tailwindcss-language-server",
				"--stdio"
			],
			"extensions": [
				".css",
				".scss",
				".sass",
				".less",
				".html",
				".htm",
				".vue",
				".jsx",
				".tsx",
				".astro",
				".svelte"
			]
		},
		"astro": {
			"command": [
				"astro-ls",
				"--stdio"
			],
			"extensions": [
				".astro"
			]
		},
		// Dockerfile has no extension; opencode matches by extension only, so
		// only `.dockerfile`-suffixed files are routed here.
		"dockerls": {
			"command": [
				"docker-langserver",
				"--stdio"
			],
			"extensions": [
				".dockerfile"
			]
		},
		// Compose service claims all YAML because no generic YAML server is
		// installed; it may report false positives on plain YAML files.
		"docker_compose_language_service": {
			"command": [
				"docker-compose-langserver",
				"--stdio"
			],
			"extensions": [
				".yaml",
				".yml"
			]
		},
		"markdown_oxide": {
			"command": [
				"markdown-oxide"
			],
			"extensions": [
				".md",
				".markdown"
			]
		},
		"texlab": {
			"command": [
				"texlab"
			],
			"extensions": [
				".tex",
				".bib"
			]
		},
		// Mirrors the neovim override, which restricts emmet to HTML.
		"emmet_language_server": {
			"command": [
				"emmet-language-server",
				"--stdio"
			],
			"extensions": [
				".html",
				".htm"
			]
		},
		"nu-lsp": {
			"command": [
				"nu",
				"--lsp"
			],
			"extensions": [
				".nu"
			]
		},
		// mojo-lsp-server is not packaged in nixpkgs and is not installed.
		// This runs it from an ephemeral `max[all]` environment; the neovim
		// workflow expects `uv add "max[all]"` inside a project instead.
		"mojo": {
			"command": [
				"uvx",
				"--from",
				"max[all]",
				"mojo-lsp-server"
			],
			"extensions": [
				".mojo",
				".🔥"
			]
		}
	},
	"mcp": {
		"servers": {
			"markitdown": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"nixpkgs#markitdown-mcp"
				],
				"disabled": true
			},
			"ripwire": {
				"type": "local",
				"command": [
					"ripwire",
					"--mcp"
				],
				"disabled": true
			},
			"arxiv": {
				"type": "local",
				"command": [
					"uvx",
					"--from",
					"arxiv-mcp-server[pdf]",
					"arxiv-mcp-server"
				],
				"disabled": true
			},
			"graphify": {
				"type": "local",
				"command": [
					"graphify-mcp",
					"./graphify-out/graph.json"
				],
				"disabled": true
			},
			"openrouter": {
				"type": "remote",
				"url": "https://mcp.openrouter.ai/mcp",
				"disabled": true
			},
			"playwright": {
				"type": "local",
				"command": [
					"npx",
					"@playwright/mcp@latest"
				],
				"disabled": true
			},
			// The bunx variant is kept as a comment, as in the V1 file:
			// "shadcn-vue": {
			// 	"type": "local",
			// 	"enabled": false,
			// 	"command": [
			// 		"bunx",
			// 		"--bun",
			// 		"shadcn-vue@latest",
			// 		"mcp",
			// 		"init",
			// 		"--client",
			// 		"opencode"
			// 	]
			// },
			"shadcn-vue": {
				"type": "local",
				"command": [
					"npx",
					"shadcn-vue@latest",
					"mcp"
				],
				"disabled": true
			},
			"nixos": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"github:utensils/mcp-nixos",
					"--"
				],
				"disabled": true
			},
			"chrome-devtools": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"chrome-devtools-mcp@latest"
				],
				"disabled": true
			},
			"github": {
				"type": "local",
				"command": [
					"nix",
					"run",
					"nixpkgs#github-mcp-server",
					"--",
					"stdio"
				],
				"disabled": true
			},
			"filesystem": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"@modelcontextprotocol/server-filesystem",
					"{env:HOME}/",
					"{env:HOME}/hacking/",
					"{env:HOME}/Downloads/"
				],
				"disabled": true
			}
		}
	},
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git"
	],
	"instructions": [
		"AGENTS.md",
		"CLAUDE.md",
		"RIPWIRE.md"
	],
	"agents": {
		"title": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"build": {
			"description": "Primary coding agent for development work",
			"mode": "primary"
		}
	},
	"permissions": [
		{
			"action": "mcp_*",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "external_directory",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "read",
			"resource": "**/.env",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.local",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.production",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.env.development",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.secrets",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/.secrets.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/secrets",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/secrets.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/credentials",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/credentials.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/id_rsa",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/id_rsa.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.pem",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.key",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "**/*.p12",
			"effect": "deny"
		},
		{
