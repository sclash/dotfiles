{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode-go/mimo-v2.6-pro",
	"small_model": "opencode-go/deepseek-v4.1-flash",
	"provider": {
		"llama.cpp": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "llama-server (vast.ai)",
			"options": {
				"baseURL": "https://notebooks-jane-themes-pros.trycloudflare.com/"
			},
			"models": {
				"unsloth/Qwen3.6-27B-GGUF": {
					"name": "Qwen3.6-27B"
				}
			}
		},
		"openrouter": {
			"options": {
				"apiKey": "{file:/run/secrets/openrouter}"
			},
			"models": {
				"xiaomi/mimo-v2.6-pro": {},
				"openai/gtp-6-astra-pro": {
					"options": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6-astra": {
					"options": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6.1-sol-pro": {
					"options": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gtp-6.1-sol": {
					"options": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4.1-flash": {
					"options": {
						"provider": {
							"order": [
								"deepseek"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4-pro-0813": {
					"options": {
						"provider": {
							"order": [
								"streamlake"
							],
							"allow_fallbacks": false
						}
					}
				},
				"deepseek/deepseek-v4-flash-0731": {
					"options": {
						"provider": {
							"order": [
								"open-inference/fp8",
								"akashml/fp8"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3": {
					"options": {
						"provider": {
							"order": [
								"friendli",
								"cloudflare",
								"akashml/fp8"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3-flash": {
					"options": {
						"provider": {
							"order": [
								"z-ai/fp8",
								"novita/fp8",
								"deepinfra/fp8",
								"gmicloud/fp8"
							],
							"allow_fallbacks": false
						}
					}
				}
			}
		},
		"opencode-go": {
			"options": {
				"apiKey": "{file:/run/secrets/opencode}"
			}
		},
		"opencode": {
			"options": {
				"apiKey": "{file:/run/secrets/opencode}"
			}
		},
		"cheaper-inference": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Cheaper Inference",
			"options": {
				"baseURL": "https://api.cheaperinference.com/v1",
				"apiKey": "{file:/run/secrets/cheaper_inference}"
			},
			"models": {
				"glm-5.3": {
					"name": "glm-5.3",
					"reasoning": true,
					"variants": {
						"low": {
							"reasoningEffort": "low"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"glm-5.3-flash": {
					"name": "glm-5.3-flash",
					"variants": {
						"low": {
							"reasoningEffort": "low"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"glm-6.1-sol": {
					"name": "gpt-6.1-sol",
					"variants": {
						"none": {
							"reasoningEffort": "none"
						},
						"low": {
							"reasoningEffort": "low"
						},
						"medium": {
							"reasoningEffort": "medium"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"xhigh": {
							"reasoningEffort": "xhigh"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"gpt-6-astra": {
					"name": "gpt-6-astra",
					"variants": {
						"low": {
							"reasoningEffort": "low"
						},
						"medium": {
							"reasoningEffort": "medium"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"xhigh": {
							"reasoningEffort": "xhigh"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"fable-5.1": {
					"name": "claude-fable-5.1",
					"variants": {
						"low": {
							"reasoningEffort": "low"
						},
						"medium": {
							"reasoningEffort": "medium"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"xhigh": {
							"reasoningEffort": "xhigh"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"opus-5.5": {
					"name": "claude-opus-5.5",
					"variants": {
						"low": {
							"reasoningEffort": "low"
						},
						"medium": {
							"reasoningEffort": "medium"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"xhigh": {
							"reasoningEffort": "xhigh"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"deepseek-v4-pro-0813": {
					"name": "deepseek-v4-pro-0813",
					"variants": {
						"none": {
							"reasoningEffort": "none"
						},
						"low": {
							"reasoningEffort": "low"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				},
				"deepseek-v4.1-flash": {
					"name": "deepseek-v4.1-flash",
					"variants": {
						"none": {
							"reasoningEffort": "none"
						},
						"low": {
							"reasoningEffort": "low"
						},
						"high": {
							"reasoningEffort": "high"
						},
						"max": {
							"reasoningEffort": "max"
						}
					}
				}
			}
		}
	},
	"lsp": {
		"tailwind": {
			"command": [
				"npx",
				"-p",
				"@tailwindcss/language-server",
				"-y",
				"tailwindcss-language-server",
				"--stdio"
			],
			"extensions": [
				".css",
				".htmx",
				".vue",
				".jsx",
				".tsx"
			]
		},
		"quickshell": {
			"command": [
				"qmlls",
				"-E"
			],
			"extensions": [
				".qml",
				".qmljs"
			]
		}
	},
	"mcp": {
		"markitdown": {
			"type": "local",
			"enabled": false,
			"command": [
				"nix",
				"run",
				"nixpkgs#markitdown-mcp"
			]
		},
		"ripwire": {
			"type": "local",
			"enabled": false,
			"command": [
				"ripwire",
				"--mcp"
			]
		},
		"arxiv": {
			"type": "local",
			"enabled": false,
			"command": [
				"uvx",
				"--from",
				"arxiv-mcp-server[pdf]",
				"arxiv-mcp-server"
			]
		},
		"graphify": {
			"type": "local",
			"enabled": false,
			"command": [
				"graphify-mcp",
				"./graphify-out/graph.json"
			]
		},
		"openrouter": {
			"type": "remote",
			"url": "https://mcp.openrouter.ai/mcp",
			"enabled": false
		},
		"playwright": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"@playwright/mcp@latest"
			]
		},
		// "shadcn-vue": {
		// 	"type": "local",
		// 	"enabled": false,
		// 	"command": [
		// 		"bunx",
		// 		"--bun",
		// 		"shadcn-vue@latest",
		// 		"mcp",
		// 		"init",
		// 		"--client",
		// 		"opencode"
		// 	]
		// },
		"shadcn-vue": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"shadcn-vue@latest",
				"mcp"
			]
		},
		"nixos": {
			"type": "local",
			"enabled": false,
			"command": [
				"nix",
				"run",
				"github:utensils/mcp-nixos",
				"--"
			]
		},
		"chrome-devtools": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"-y",
				"chrome-devtools-mcp@latest"
			]
		},
		"github": {
			"type": "local",
			"enabled": false,
			"command": [
				"nix",
				"run",
				"nixpkgs#github-mcp-server",
				"--",
				"stdio"
			]
		},
		"filesystem": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"/home/asergi/",
				"/home/asergi/hacking/",
				"/home/asergi/Downloads/"
			]
		}
	},
	"plugin": [
		"superpowers@git+https://github.com/obra/superpowers.git"
	],
	"instructions": [
		"AGENTS.md"
	],
	"agent": {
		"build": {
			"description": "Primary coding agent for development work",
			"mode": "primary",
		}
	},
	"permission": {
		"mcp_*": "ask",
		"read": {
			"**/.env": "deny",
			"**/.env.local": "deny",
			"**/.env.production": "deny",
			"**/.env.development": "deny",
			"**/.secrets": "deny",
			"**/.secrets.*": "deny",
			"**/secrets": "deny",
			"**/secrets.*": "deny",
			"**/credentials": "deny",
			"**/credentials.*": "deny",
			"**/id_rsa": "deny",
			"**/id_rsa.*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny",
			"**/*.p12": "deny",
			"/run/secrets": "deny",
			"/run/secrets.d": "deny",
			"/run/secrets.d/**": "deny",
			"/run/secrets/**": "deny"
		},
		"edit": {
			"**/.env": "deny",
			"**/.env.local": "deny",
			"**/.env.production": "deny",
			"**/.env.development": "deny",
			"**/.secrets": "deny",
			"**/.secrets.*": "deny",
			"**/secrets": "deny",
			"**/secrets.*": "deny",
			"**/credentials": "deny",
			"**/credentials.*": "deny",
			"**/id_rsa": "deny",
			"**/id_rsa.*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny",
			"**/*.p12": "deny",
			"/run/secrets": "deny",
			"/run/secrets.d": "deny",
			"/run/secrets.d/**": "deny",
			"/run/secrets/**": "deny"
		},
		"glob": {
			"**/.env": "deny",
			"**/.env.local": "deny",
			"**/.env.production": "deny",
			"**/.env.development": "deny",
			"**/.secrets": "deny",
			"**/.secrets.*": "deny",
			"**/secrets": "deny",
			"**/secrets.*": "deny",
			"**/credentials": "deny",
			"**/credentials.*": "deny",
			"**/id_rsa": "deny",
			"**/id_rsa.*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny",
			"**/*.p12": "deny",
			"/run/secrets": "deny",
			"/run/secrets.d": "deny",
			"/run/secrets.d/**": "deny",
			"/run/secrets/**": "deny"
		},
		"grep": {
			"**/.env": "deny",
			"**/.env.local": "deny",
			"**/.env.production": "deny",
			"**/.env.development": "deny",
			"**/.secrets": "deny",
			"**/.secrets.*": "deny",
			"**/secrets": "deny",
			"**/secrets.*": "deny",
			"**/credentials": "deny",
			"**/credentials.*": "deny",
			"**/id_rsa": "deny",
			"**/id_rsa.*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny",
			"**/*.p12": "deny",
			"/run/secrets": "deny",
			"/run/secrets.d": "deny",
			"/run/secrets.d/**": "deny",
			"/run/secrets/**": "deny"
		},
		"bash": {
			"*": "ask",
			"*/run/secrets*": "deny",
			"*cat /run/secrets*": "deny",
			"*cat /run/secrets.d*": "deny",
			"*head /run/secrets*": "deny",
			"*tail /run/secrets*": "deny",
			"*base64 /run/secrets*": "deny",
			"*xxd /run/secrets*": "deny",
			"*strings /run/secrets*": "deny",
			"*cp /run/secrets*": "deny",
			"*pip install *": "ask",
			"*pip3 install *": "ask",
			"*python -m pip install *": "ask",
			"*python3 -m pip install *": "ask",
			"*uv tool *": "ask",
			"*uv pip install *": "ask",
			"*npm install -g *": "ask",
			"*npm i -g *": "ask",
			"*npm add -g *": "ask",
			"*npm uninstall -g *": "ask",
			"*npm update -g *": "ask",
			"*pnpm add -g *": "ask",
			"*pnpm install -g *": "ask",
			"*yarn global *": "ask",
			"*cargo install *": "ask",
			"*go install *": "ask",
			"*gem install *": "ask",
			"*apt install *": "ask",
			"*apt-get install *": "ask",
			"*dnf install *": "ask",
			"*brew install *": "ask",
			"*pacman -S *": "ask",
			"*yay -S *": "ask",
			"*paru -S *": "ask",
			"*nix-env *": "ask",
			"*nix profile install *": "ask",
			"*nix-channel --add *": "ask",
			"*sudo *": "ask",
			"**/.env": "deny",
			"**/.env.local": "deny",
			"**/.env.production": "deny",
			"**/.env.development": "deny",
			"**/.secrets": "deny",
			"**/.secrets.*": "deny",
			"**/secrets": "deny",
			"**/secrets.*": "deny",
			"**/credentials": "deny",
			"**/credentials.*": "deny",
			"**/id_rsa": "deny",
			"**/id_rsa.*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny",
			"**/*.p12": "deny",
			"/run/secrets": "deny",
			"/run/secrets.d": "deny",
			"/run/secrets.d/**": "deny",
			"/run/secrets/**": "deny"
		}
	}
}
